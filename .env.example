# Copy to .env and fill in real values. Never commit .env.

# Docs repository (owner/name) that Backstage reads and Docs Studio writes to.
# Create it with scripts/docs-studio/seed-playground.mjs (see README.md).
# If unset, the original demo repository AgenticOrganization/docs-studio-playground
# is used, which is private: set this to your own repository.
DOCS_STUDIO_REPOSITORY=

# Token used by Backstage to read the docs repository above.
# A fine-grained PAT with read-only "Contents" access to that repo is enough.
# Writes (Docs Studio proposals) use a GitHub App: see app-config.local.example.yaml.
GITHUB_TOKEN=

# GitHub OAuth App used for sign-in (Homepage URL: http://localhost:3000,
# Authorization callback URL: http://localhost:7007/api/auth/github/handler/frame)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Microsoft Entra ID app registration used for sign-in (single tenant).
# Redirect URI (type Web): http://localhost:7007/api/auth/microsoft/handler/frame
# Leave them empty to start without Microsoft sign-in (guest/GitHub still work).
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=

# Optional: Python virtual environment that contains mkdocs-techdocs-core
# (TechDocs is generated locally, without Docker). Defaults to ~/.venvs/techdocs
# TECHDOCS_VENV=~/.venvs/techdocs
